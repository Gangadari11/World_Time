            },
            "url": {
              "raw": "http://localhost:5217/api/leasepaymentschedules/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "leasepaymentschedules", "1"]
            }
          }
        },
        {
          "name": "Delete Payment Schedule",
          "request": {
            "method": "DELETE",
            "description": "Deletes a payment schedule by ID. Returns 404 if not found.",
            "url": {
              "raw": "http://localhost:5217/api/leasepaymentschedules/1",
              "protocol": "http",
              "host": ["localhost"],
