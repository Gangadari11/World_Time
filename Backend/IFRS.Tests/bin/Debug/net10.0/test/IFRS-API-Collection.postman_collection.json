              "raw": "{\n  \"branchId\": 1,\n  \"lessorId\": 1,\n  \"leaseNo\": \"LEASE-2024-001\",\n  \"leasePropertyAddress\": \"789 Property Avenue, City, Country\",\n  \"sqft\": 5000,\n  \"startDate\": \"2024-01-01\",\n  \"endDate\": \"2027-12-31\",\n  \"extensions\": \"Option to extend for 3 more years\",\n  \"numberOfYears\": 3,\n  \"rentAdvance\": 50000.00,\n  \"rentAdvancePeriod\": 12,\n  \"refundableDeposit\": 100000.00,\n  \"noticePeriodMonths\": 3,\n  \"remarks\": \"Premium location with parking\",\n  \"agreementValue\": 2000000.00,\n  \"annualRate\": 10,\n  \"utilityBill\": 0.00,\n  \"whtRate\": 0,\n  \"vatRate\": 0,\n  \"leaseStatus\": \"Active\"\n}"
            
