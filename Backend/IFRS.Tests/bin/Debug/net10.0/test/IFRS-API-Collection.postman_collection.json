              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "leasepaymentschedules", "lease", "1"]
            }
          }
        },
        {
          "name": "Update Payment Schedule",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
