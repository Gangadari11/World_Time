{
  "info": {
    "name": "IFRS API",
    "description": "Complete API for IFRS Lease Management System. Includes JWT authentication with access token (15 min) and refresh token (8 hours). Both tokens are stored as HTTP-only cookies on login. Use the Authentication folder first before calling any protected endpoints.",
    "schema": "http://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "description": "All authentication endpoints. Start here. Login sets two HTTP-only cookies: accessToken (15 min) and refreshToken (8 hours). The accessToken is also returned in the response body and saved to the {{accessToken}} environment variable automatically.",
      "item": [
        {
          "name": "Check Setup",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Checks whether the first admin user needs to be created. Returns { canRegister: true } if the user table is empty. Call this before showing the registration screen. No token required.",
            "url": {
              "raw": "http://localhost:5217/api/auth/setup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "auth", "setup"]
            }
          }
        },
        {
          "name": "Register First Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Creates the very first admin user. Only works when the user table is empty — returns 403 if any user already exists. On success sets two HTTP-only cookies: accessToken (15 min expiry) and refreshToken (8 hours expiry). The accessToken is also saved to {{accessToken}} environment variable automatically via the test script.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ifrs.com\",\n  \"password\": \"Admin@12345\",\n  \"fullName\": \"System Administrator\"\n}"
            },
            "url": {
              "raw": "http://localhost:5217/api/auth/setup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "auth", "setup"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set(\"accessToken\", pm.response.json().accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Authenticates a user with email and password. On success sets two HTTP-only cookies: accessToken (15 min expiry) and refreshToken (8 hours expiry). The accessToken is also returned in the response body and saved to {{accessToken}} environment variable automatically via the test script. Returns userId, role and fullName alongside the token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ifrs.com\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "http://localhost:5217/api/auth",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "auth"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set(\"accessToken\", pm.response.json().accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "description": "Issues a new access token using the refreshToken HTTP-only cookie. No body or Authorization header needed — Postman sends the cookie automatically. On success issues a brand new refreshToken cookie (rotation — old one is deleted from DB) and a new accessToken cookie. The new accessToken is also saved to {{accessToken}} environment variable automatically. Returns 401 if the refresh token is missing, expired, or already used.",
            "url": {
              "raw": "http://localhost:5217/api/auth/refresh",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set(\"accessToken\", pm.response.json().accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Logs out the current user. Does three things: (1) deletes the refresh token from the database, (2) clears the refreshToken HTTP-only cookie, (3) clears the accessToken HTTP-only cookie. After logout calling /api/auth/refresh will return 401. The {{accessToken}} environment variable is also cleared automatically via the test script. Requires a valid access token in the Authorization header.",
            "url": {
              "raw": "http://localhost:5217/api/auth/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "auth", "logout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.unset(\"accessToken\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "description": "User management endpoints. All endpoints require a valid access token in the Authorization header. Create and Delete are restricted to admin role only. Any authenticated user can view users and update their own profile.",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Returns a list of all users. Password hashes are never returned. Accessible by any authenticated user (admin or user role).",
            "url": {
              "raw": "http://localhost:5217/api/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "users"]
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Returns a single user by their ID. Password hash is never returned. Accessible by any authenticated user (admin or user role). Returns 404 if user not found.",
            "url": {
              "raw": "http://localhost:5217/api/users/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "users", "1"]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Creates a new user. Admin role only — returns 403 for non-admin tokens. Password is hashed with BCrypt before storing. Role: 0 = admin, 1 = user. Returns 400 if email already exists.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test01@ifrs.com\",\n  \"password\": \"Test@12345\",\n  \"fullName\": \"Test User 01\",\n  \"role\": 1\n}"
            },
            "url": {
              "raw": "http://localhost:5217/api/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "users"]
            }
          }
        },
        {
          "name": "Update Own Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Updates the logged-in user's own fullName and email. User identity is read from the JWT token — no user ID needed in the URL. Cannot change own role. Returns 400 if email already taken by another user.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Updated Name\",\n  \"email\": \"updated@ifrs.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:5217/api/users/profile",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "users", "profile"]
            }
          }
        },
        {
          "name": "Update Own Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Updates the logged-in user's own password along with profile details. currentPassword must match the existing password otherwise returns 400. newPassword is hashed with BCrypt before storing. User identity is read from the JWT token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Updated Name\",\n  \"email\": \"updated@ifrs.com\",\n  \"currentPassword\": \"Admin@12345\",\n  \"newPassword\": \"NewPass@12345\"\n}"
            },
            "url": {
              "raw": "http://localhost:5217/api/users/profile",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "users", "profile"]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "Deletes a user by ID. Admin role only — returns 403 for non-admin tokens. Returns 404 if user not found. All refresh tokens for the deleted user are also removed via cascade delete in the database.",
            "url": {
              "raw": "http://localhost:5217/api/users/2",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5217",
              "path": ["api", "users", "2"]
            }
          }
        }
      ]
    },
