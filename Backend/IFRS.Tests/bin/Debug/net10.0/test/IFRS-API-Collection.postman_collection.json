    {
      "name": "Lease Payment Schedules",
      "description": "CRUD endpoints for managing annual payment schedules linked to leases. No authentication required.",
      "item": [
        {
          "name": "Create Payment Schedule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Creates a new payment schedule for a lease. leaseId must reference an existing lease. grossAmount is required and must be non-negative. Returns 409 Conflict if payment schedules already exist for the lease.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaseId\": 1,\n  \"yearlyPayments\": [\n    { \"leaseYear\": 1, \"grossAmount\": 500000.00 },\n    { \"leaseYear\": 2, \"grossAmount\": 520000.00 },\n    { \"leaseYear\": 3, \"grossAmount\": 540000.00}\n  ]\n}"
            },
